#!/bin/sh
# git commit-msg 훅. 키트 검사 조각(commit-msg.d)과 저장소 훅을 이어 부르는 일은 chain.sh가 한다(그 머리말에 저장소 설정과 env 방식의 차이가 있다).
# 왜: 묶음마다 검사가 따로 깔리고 빠지게 하려는 것이다(조각은 git-dispatch.cjs가 부름). 이어 부르기를 sh에 두는 까닭은 shebang 스크립트를 Windows에서 node가 바로 띄우지 못해서다. git이 훅을 자기 sh로 돌리므로 Git Bash가 처리한다.
exec sh "$(dirname "$0")/chain.sh" commit-msg "$@"
