{
  "bundle": "safety",
  "part": "core",
  "origin": "kit",
  "files": [
    "subagent-system/hooks/rm-guard.js",
    "subagent-system/hooks/git-discard-guard.js",
    "subagent-system/hooks/supabase-sql-guard.js",
    "subagent-system/hooks/guardShared.cjs",
    "subagent-system/scripts/trash.js",
    "subagent-system/scripts/tests/safetyGuards.test.js",
    "subagent-system/scripts/tests/trash.test.js"
  ],
  "hooks": [
    {
      "name": "rm-guard",
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "node \"$HOME/.claude/subagent-system/hooks/rm-guard.js\"",
      "timeout": 10
    },
    {
      "name": "git-discard-guard",
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "node \"$HOME/.claude/subagent-system/hooks/git-discard-guard.js\"",
      "timeout": 10
    },
    {
      "name": "supabase-sql-guard",
      "event": "PreToolUse",
      "matcher": "mcp__supabase__execute_sql",
      "command": "node \"$HOME/.claude/subagent-system/hooks/supabase-sql-guard.js\"",
      "timeout": 10
    }
  ],
  "gitHooks": []
}
