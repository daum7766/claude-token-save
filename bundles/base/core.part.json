  "hooks": [
    {
      "name": "ask-log",
      "event": "PermissionRequest",
      "matcher": "*",
      "command": "node \"$HOME/.claude/subagent-system/hooks/ask-log.js\"",
      "timeout": 10
    }
  ],
  "gitHooks": [
    {
      "hook": "commit-msg",
      "name": "kit-note",
      "order": 10,
      "file": "subagent-system/hooks/git/commit-msg.d/10-kit-note.cjs"
    },
    {
      "hook": "pre-commit",
      "name": "kit-drift",
      "order": 10,
      "file": "subagent-system/hooks/git/pre-commit.d/10-kit-drift.cjs"
    }
  ]
